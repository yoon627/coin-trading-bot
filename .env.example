# Upbit API
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# KIS (한국투자증권) 주식 봇 — 전역 설정. 사용자별 appkey/appsecret/계좌는 앱 안에서 등록.
# 실주문 2축 안전장치: KIS_LIVE_ENABLED=false 면 dry-run(주문 미송신, WAL 에 DRY_RUN 기록).
# 실거래는 KIS_LIVE_ENABLED=true + 사용자 계좌 kis_paper=false 둘 다 명시해야 나간다.
# 전역(단일 계정) KIS 자격증명 — 넣어두면 봇/스모크가 자동 사용. 같은 키로 국내/해외 공용.
# (멀티유저는 앱 안에서 유저별 등록 — 그쪽은 DB 암호화 저장. 전역 .env 는 평문이나 gitignored.)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=                          # 종합계좌번호 앞 8자리
KIS_ACNT_PRDT_CD=01               # 계좌상품코드 뒤 2자리
KIS_PAPER=true                     # true=모의(:29443), false=실전(:9443)
KIS_LIVE_ENABLED=false             # 실주문 송신 게이트. 실거래는 KIS_PAPER=false + 이 값 true 둘 다 필요
KIS_MAX_ORDER_AMOUNT=10000000      # 단일 주문 명목금액(원) 상한. 0=무제한
# 자율엔진 시세수집 watchlist(6자리 CSV, 예 005930,000660). 비우면 엔진이 per-user REST 폴백
KIS_MARKETDATA_SYMBOLS=
# 도메인은 기본값(실전 :9443 / 모의 :29443) 사용. 필요 시만 오버라이드.
# KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443
# KIS_PAPER_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_RECONCILE_INTERVAL_MS=15000    # 주문 reconcile 주기

# Trading
#
# ⚠️ 아래 청산 6개 키는 자동매매(TRADING_AUTO_START=true) 배포에서 **필수**다 (#179).
# 비워 두면 deploy.sh 의 preflight 가 배포를 중단한다 — 운영값이 앱 기본값과 다를 수 있어(트레일링),
# 한 줄이 빠지면 봇이 조용히 다른 청산 규칙으로 거래하기 때문이다. 값은 그 배포의 운영값을 적는다.
# 나머지 리스크 키는 선택이며, 설정하지 않으면 TradingProperties 기본값이 적용된다 —
# 기본값을 여기 옮겨 적으면 앱과 갈리므로(#75) 비워 둔다.
# 현재 기본값: common/src/main/kotlin/com/trading/common/config/TradingProperties.kt (README 표에도 정리)
TRADING_TICKERS=KRW-BTC,KRW-ETH
TRADING_STRATEGY=combined
#TRADING_INVEST_RATIO=
#TRADING_MAX_INVEST_AMOUNT=
TRADING_TAKE_PROFIT_PCT=
TRADING_MAX_LOSS_PCT=
TRADING_TRAILING_STOP_PCT=
# 트레일링 arm 임계(%) — 고점 수익률 도달 후에만 트레일링 평가. 0=수익 중 즉시. trail 보다 클 때만 실효
TRADING_TRAILING_ARM_PCT=
# 보유 상한(거래일, KST 09:00 경계) — 1=일일리셋
TRADING_MAX_HOLD_DAYS=
# 차트/지표 기반 청산(데드크로스 등) 토글
TRADING_CHART_EXIT_ENABLED=
# 왕복 수수료 비율(기록용 net pnl 차감) — Upbit 0.05%x2
#TRADING_ROUND_TRIP_FEE_RATE=

# Discord Notification (optional)
DISCORD_WEBHOOK_URL=
# Error alert (opt-in): use a separate webhook/channel.
# enabled=true + URL -> server ERROR logs are sent to that channel.
DISCORD_ERROR_ALERT_ENABLED=false
DISCORD_ERROR_WEBHOOK_URL=

# Database (prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trading
DB_PASSWORD=trading
