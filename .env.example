# Trading
#
# 루트 compose 의 app 이 읽는 로컬용 파일이다. 운영 배포 템플릿은 deploy/vultr/.env.example 이다.
# 아래 청산 키 5개를 빈 값으로 두면 app 이 바인딩에 실패하므로 값을 넣거나 줄 앞에 # 를 붙인다.
# 나머지 리스크 키를 비워 두면 TradingProperties 기본값을 쓴다. 기본값을 여기 옮겨 적지 않는다.
TRADING_TICKERS=KRW-BTC,KRW-ETH
#TRADING_INVEST_RATIO=
#TRADING_MAX_INVEST_AMOUNT=
TRADING_TAKE_PROFIT_PCT=
TRADING_MAX_LOSS_PCT=
TRADING_TRAILING_STOP_PCT=
# 고점 수익률이 이 값(%)에 닿은 뒤에만 트레일링을 평가한다. 0 이면 수익 구간에서 바로 평가한다.
TRADING_TRAILING_ARM_PCT=
# 보유 상한(거래일, KST 09:00 경계). 이 거래일 수가 지나면 강제 청산한다.
TRADING_MAX_HOLD_DAYS=
# 왕복 수수료 비율. 기록용 순손익에서만 뺀다.
#TRADING_ROUND_TRIP_FEE_RATE=

# Discord 알림 (선택)
DISCORD_WEBHOOK_URL=
# ERROR 로그를 별도 채널로 보낸다. enabled=true 와 URL 이 둘 다 있어야 한다.
DISCORD_ERROR_ALERT_ENABLED=false
DISCORD_ERROR_WEBHOOK_URL=

# Database (prod 프로필)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trading
# 비워 두면 로컬 기본값 trading 을 쓴다.
# DB_PASSWORD=trading
