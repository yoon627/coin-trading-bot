# Trading
#
# 루트 compose 의 app 이 env_file 로 통째로 읽는 로컬용 파일이다. 배포가 넘기는 키 전체는 운영 템플릿
# deploy/vultr/.env.example 에 있고, 설명은 README 의 설정 표에 있다.
# 빈 `KEY=` 는 빈 문자열로 앱에 닿아 숫자 키는 바인딩에 실패하므로, 쓰지 않는 키는 줄 앞에 # 를 둔다.
# 막아 둔 키는 TradingProperties 기본값을 쓴다. 기본값을 여기 옮겨 적지 않는다.
TRADING_TICKERS=KRW-BTC,KRW-ETH
#TRADING_INVEST_RATIO=
#TRADING_MAX_INVEST_AMOUNT=
#TRADING_TAKE_PROFIT_PCT=
#TRADING_MAX_LOSS_PCT=
#TRADING_TRAILING_STOP_PCT=
# 고점 수익률이 이 값(%)에 닿은 뒤에만 트레일링을 평가한다. 0 이면 수익 구간에서 바로 평가한다.
#TRADING_TRAILING_ARM_PCT=
# 보유 상한(거래일, KST 09:00 경계). 이 거래일 수가 지나면 강제 청산한다.
#TRADING_MAX_HOLD_DAYS=
# 왕복 수수료 비율. 기록용 순손익에서만 뺀다.
#TRADING_ROUND_TRIP_FEE_RATE=

# 비우면 앱이 뜰 때마다 임시 키를 만들어, 재시작하면 세션이 끊기고 저장한 Upbit 키를 복호화하지 못한다.
JWT_SECRET=
APP_ENCRYPTION_SECRET=

# Discord 알림 (선택)
DISCORD_WEBHOOK_URL=
# ERROR 로그를 별도 채널로 보낸다. enabled=true 와 URL 이 둘 다 있어야 한다.
DISCORD_ERROR_ALERT_ENABLED=false
DISCORD_ERROR_WEBHOOK_URL=

# Database. 접속 주소는 루트 compose 가 정한다. 비밀번호는 compose 가 app 과 postgres 에 함께 넘기고 비워 두면 trading 이다.
# DB_PASSWORD=trading
