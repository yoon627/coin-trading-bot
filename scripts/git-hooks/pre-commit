#!/usr/bin/env bash
# pre-commit: 민감 경로 검사(#299). Claude Code 훅은 Bash 호출의 `git commit` 에만 걸려 스크립트 안에서 부른 커밋을
# 놓치고, 명령을 실행하기 **전** index 를 보므로 `git add X && git commit` 의 X 도 놓친다 — git 훅은 실제 커밋 시점에 돈다.
#
# 설치: cp scripts/git-hooks/pre-commit "$(git rev-parse --git-path hooks)/pre-commit" && chmod +x "$(git rev-parse --git-path hooks)/pre-commit"
script="$(git rev-parse --show-toplevel)/scripts/git-hooks/check-staged-sensitive.sh"
# .git/hooks 는 모든 worktree 가 공유한다 — 이 스크립트가 없는 옛 브랜치의 worktree 에서는 막지 않고 알린다.
if [ ! -f "$script" ]; then
  echo "[pre-commit] 민감 경로 검사 스크립트가 이 브랜치에 없어 건너뛴다: $script" >&2
  exit 0
fi
exec bash "$script"
