#!/usr/bin/env bash
# pre-push: deploy.yml 의 paths-ignore 가 워크플로 자신을 제외하는 변경만 막는다(#151).
#
# codex 리뷰 게이트는 2026-09-03 에 제거했다 — 코드 리뷰는 구현 직후 리뷰 단계
# (code-reviewer + codex 병행)가 담당한다. 경위는 wiki `prepush-codex-review`.
#
# 설치: cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Stdin from git: <local_ref> <local_sha> <remote_ref> <remote_sha>  per ref being pushed.

set -uo pipefail

ZERO_SHA="0000000000000000000000000000000000000000"

# deploy.yml 의 paths-ignore 에 워크플로 파일 자신을 매칭하는 패턴이 있으면 deploy.yml 을 바꾸는
# push 가 워크플로 실행을 만들지 않는다 — 경로 목록을 강제하는 DeployWorkflowPathListTest 가 영영
# 돌지 않게 되고, 검사가 자기 자신을 끈 상태가 된다(#151).
#
# 여기서는 그 자기무력화 패턴만 본다. 목록 동기·배포 입력 같은 나머지 불변식은 그 테스트가
# 담당한다 — hook 에서 gradle 을 돌리지 않는 이유는 JDK 환경에 따라 ./gradlew 가 실패해
# 모든 push 를 막을 수 있기 때문이다.
guard_workflow_self_exclusion() {
  local sha="$1" yml=".github/workflows/deploy.yml" content ignore_block bad
  content="$(git show "$sha:$yml" 2>/dev/null)" || return 0

  # inline 형식(`paths-ignore: [ ... ]`)은 아래 블록 파서가 못 읽는다. 읽을 수 없는 형식이면
  # 통과시키지 않고 막는다(fail-closed) — 파싱 실패가 곧 우회가 되면 가드가 무의미하다.
  if printf '%s\n' "$content" | grep -qE '^ *paths-ignore: *\['; then
    echo "[pre-push] FAIL: deploy.yml 의 paths-ignore 가 inline 형식이다 — 이 가드는 블록 형식만" >&2
    echo "[pre-push]   읽는다. 블록 형식으로 두거나 scripts/git-hooks/pre-push 의 파서를 함께 고쳐라." >&2
    return 1
  fi

  ignore_block="$(printf '%s\n' "$content" \
    | awk '/paths-ignore:/{f=1;next} f&&/^ *- /{print;next} f{exit}')"
  [ -z "$ignore_block" ] && return 0

  # 패턴을 하나씩 나열하면 계속 빠진다(`.github/workflows/*.yml`·`**/deploy.yml` 도 이 파일을
  # 매칭한다). 그래서 워크플로 파일에 닿을 수 있는 표지 — `.github`, `.yml`/`.yaml`, 선두 `**` —
  # 가 보이면 일단 막는다. 따옴표는 작은/큰/없음을 모두 본다.
  bad="$(printf '%s\n' "$ignore_block" \
    | sed -E "s/^ *- *//; s/^['\"]//; s/['\"] *$//" \
    | grep -E "(\.github|\.ya?ml|^\*\*$|^\*\*/)" || true)"

  if [ -n "$bad" ]; then
    echo "[pre-push] FAIL: deploy.yml 의 paths-ignore 가 워크플로 자신을 제외한다 — $bad" >&2
    echo "[pre-push]   그 패턴이 있으면 deploy.yml 을 바꾸는 push 가 CI 를 만들지 않아," >&2
    echo "[pre-push]   경로 목록 검사(DeployWorkflowPathListTest)가 영영 돌지 않는다." >&2
    return 1
  fi
  return 0
}

check_ref() {
  local local_ref="$1" local_sha="$2" remote_sha="$3"

  if [ "$local_sha" = "$ZERO_SHA" ]; then
    echo "[pre-push] $local_ref: deletion, skipping."
    return 0
  fi
  if [ "$local_sha" = "$remote_sha" ]; then
    echo "[pre-push] $local_ref: no new commits."
    return 0
  fi
  guard_workflow_self_exclusion "$local_sha"
}

rc=0
while IFS=' ' read -r local_ref local_sha _remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
  [ -z "${local_ref:-}" ] && continue
  check_ref "$local_ref" "$local_sha" "$remote_sha" || rc=1
done
exit "$rc"
