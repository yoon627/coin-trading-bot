# ── Vultr ──
# API 키: 콘솔 → Account → API 에서 발급.
# ⚠️ Vultr API 는 기본적으로 호출 IP 를 화이트리스트로 제한한다 — 같은 화면의 'Access Control' 에
#    현재 공인 IP 를 반드시 추가해야 한다(안 하면 모든 호출이 401/403).
VULTR_API_KEY=

VULTR_REGION=icn                  # icn = 서울
VULTR_PLAN=vc2-1c-2gb             # 1 vCPU / 2GB / 55GB SSD / 2TB — $10/월
VULTR_OS_ID=2284                  # Ubuntu 24.04 LTS x64
APP_NAME=coin-trading-bot
SSH_USER=root                     # Vultr 기본 사용자

# 2GB 로 낮춘 근거는 운영 59일차 AWS EC2 실측이다:
#   app 420MiB / postgres 380MiB / redis 3.4MiB / caddy 14MiB = 818MiB, load average 0.00
# 더 여유가 필요하면 vc2-2c-2gb($15) 또는 vc2-2c-4gb($20) 로 올린다(콘솔에서 리사이즈 가능).

# 접근 제한 (보안). 비우면 setup 시 현재 공인 IP/32 로 자동 제한.
# GitHub-hosted Actions 배포는 cloud firewall의 ctb-ssh-github-actions 규칙(22/tcp, 0.0.0.0/0)을
# 별도로 사용한다. 이 값은 수동 관리용 SSH 대역이다. 비우면 setup 시 현재 공인 IP/32로 제한한다.
SSH_ALLOW_CIDR=
APP_ALLOW_CIDR=                   # 비우면 0.0.0.0/0 (TLS 종단이라 허용, 로그인은 앱의 IP rate limit 으로 방어)

# ── 이미지 (GitHub Actions 가 GHCR 로 push) ──
# arm64(AWS) → amd64(Vultr) 로 아키텍처가 바뀌지만 이미지가 multi-arch 라 그대로 pull 된다.
GHCR_IMAGE=ghcr.io/yoon627/coin-trading-bot
APP_VERSION=latest
GHCR_USERNAME=
GHCR_TOKEN=

# ── 앱 시크릿 ──
# ⚠️ APP_ENCRYPTION_SECRET 은 **자동 생성되지 않는다**(비어 있으면 setup·deploy 가 실패한다). 저장된 Upbit
#    키를 복호화하는 AES 키라, 새 키를 만들면 앱은 정상 기동하면서 거래소 키만 조용히 복호화 불능이 된다.
#    → 운영 중인 값을 그대로 쓸 것: 서버 /opt/app/.env, 로컬 deploy/vultr/.env, 오프사이트 보관본.
#      GitHub secret(VULTR_DEPLOY_ENV)은 다시 읽을 수 없어 출처가 될 수 없다.
DB_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_SECRET=

# ── Upbit API ──
# 거래에는 쓰이지 않는다(#300) — 거래 키는 사용자별로 앱 설정 화면에서 넣고 DB 에 암호화돼 있다. 그래서 여기를
# 비워도 이중 거래를 막지 못한다: 호스트를 옮길 때는 TRADING_AUTO_START=false 로 두고 README 4절(호스트 이전)을 따를 것.
# ⚠️ Upbit API 키에 허용 IP 를 등록해 쓴다면 새 호스트 IP 를 추가할 것.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── DB 백업 (S3 호환 — 선택) ──
# Vultr 에는 AWS IAM 인스턴스 롤 같은 것이 없어 액세스 키를 서버에 둬야 한다.
# 반드시 **이 버킷에만 권한이 있는 전용 키**를 발급할 것.
#   - AWS S3 재사용   : ENDPOINT 를 비우고 기존 계정에 버킷 생성 (백업 용량이 작아 월 $0.1 미만)
#   - Vultr Object Storage : ENDPOINT=https://sgp1.vultrobjects.com ($5/월 250GB)
#   - Cloudflare R2   : ENDPOINT=https://<account>.r2.cloudflarestorage.com (10GB 무료)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=14
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_REGION=ap-northeast-2

# ── 트레이딩 ──
# ⚠️ 이전 직후에는 반드시 false. 검증이 끝난 뒤 수동으로 켠다(단일 실행 보장).
TRADING_AUTO_START=false
TRADING_TICKERS=KRW-BTC
# ⚠️ 아래 청산 5개 키는 자동매매(TRADING_AUTO_START=true) 배포에서 **필수**다 (#179).
# 비워 두면 deploy.sh 의 preflight 가 배포를 중단한다 — 운영값이 앱 기본값과 다를 수 있어(트레일링),
# 한 줄이 빠지면 봇이 조용히 다른 청산 규칙으로 거래하기 때문이다. 값은 그 배포의 운영값을 적는다.
# 값은 의미상 구간 안이어야 한다(예: 손절 (0, 100) — 부호 오기 -5 는 매수 직후 손절이 된다). 구간·형식을 벗어나면
# (지수·쉼표·공백·대문자 불리언 포함) 자동매매 여부와 무관하게 preflight_exit_params.sh 가 배포를 중단한다.
# 구간 표: README "기본 리스크 관리" 절, 정의처는 common/src/main/kotlin/com/trading/common/config/ExitParamRanges.kt
# 나머지 리스크 키는 선택이며, 설정하지 않으면 TradingProperties 기본값이 적용된다 —
# 기본값을 여기 옮겨 적으면 앱과 갈리므로(#75) 비워 둔다.
# 현재 기본값: common/src/main/kotlin/com/trading/common/config/TradingProperties.kt (README 표에도 정리)
# 1회 매수액 = min(주문가능 KRW × INVEST_RATIO, MAX_INVEST_AMOUNT). 업비트 최소 주문은 5,000원이라
# 거래 종목을 늘릴수록 뒤쪽 종목 매수액이 작아지는 점을 함께 고려할 것.
#TRADING_INVEST_RATIO=
#TRADING_MAX_INVEST_AMOUNT=
TRADING_TAKE_PROFIT_PCT=
TRADING_MAX_LOSS_PCT=
TRADING_TRAILING_STOP_PCT=
TRADING_TRAILING_ARM_PCT=
TRADING_MAX_HOLD_DAYS=
#TRADING_ROUND_TRIP_FEE_RATE=
# reconcilePendingBuy 의 조회가 연속 이 횟수만큼 실패하면 해당 ticker 를 halt(기본 20 ≈ 200초).
#TRADING_RECONCILE_HALT_THRESHOLD=

# ── 그림자 청산 관측 (기본 off, 매매 무영향) ──
# 후보 청산 파라미터를 라이브와 **나란히 평가해 기록만** 한다. 주문도 상태 전이도 없다.
# 목적은 수익 판정이 아니라 **모델 검증**이다 — 백테가 트레일링 체결가로 쓰는 임계선
# `peak × (1 − trailing_stop_pct/100)` 이 실제 10초 tick 에서 얼마나 낙관인지를 잰다.
# (수익 우위 판정은 현재 거래 빈도로 약 4.7년이 걸려 이 관측의 목적이 아니다.)
# 관측은 `shadow_exit_observation` 테이블에 포지션당 1건 쌓인다. 판정 기준은
# `.claude/plans/2026-09-05-trailing-shadow/` `# Acceptance` 4 에 사전고정돼 있다.
# 기본값은 wiki `query/trailing-arm-finding-2026-09` 이 통과시킨 변형 A 다.
# 켜졌는지는 기동 로그로 확인한다: `[shadow-exit] 관측 on — user … 후보 트레일링 …`
# (전달 계층이 넷이라 어느 한 곳에서 빠지면 조용히 off 로 돈다 — 로그가 유일한 조기 신호다.)
#TRADING_SHADOW_EXIT_ENABLED=true
#TRADING_SHADOW_EXIT_TRAILING_STOP_PCT=1.5
#TRADING_SHADOW_EXIT_TRAILING_ARM_PCT=0

# ── Discord 웹훅 (선택) ──
DISCORD_WEBHOOK_URL=
DISCORD_ERROR_ALERT_ENABLED=false
DISCORD_ERROR_WEBHOOK_URL=

# ── TLS / 도메인 ──
# 비우면 deploy.sh 가 공인 IP 기반 sslip.io 도메인으로 자동 생성.
# ⚠️ IP 가 바뀌면 도메인도 바뀐다(인증서·CORS·북마크 영향). 오래 운영하려면 보유 도메인 A 레코드 권장.
APP_DOMAIN=
APP_AUTH_COOKIE_FORCE_INSECURE=false
