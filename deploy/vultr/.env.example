# ── Vultr ──
# 콘솔 Account → API 에서 발급한다. 같은 화면의 Access Control 에 호출할 공인 IP 를 넣지 않으면 모든 호출이 401/403 이다.
VULTR_API_KEY=

VULTR_REGION=icn                  # 서울
VULTR_PLAN=vc2-1c-2gb             # 1 vCPU / 2GB / 55GB SSD
VULTR_OS_ID=2284                  # Ubuntu 24.04 LTS x64
APP_NAME=coin-trading-bot
SSH_USER=root

# 비우면 setup 이 현재 공인 IP/32 로 제한한다. GitHub Actions 배포는 방화벽의 ctb-ssh-github-actions 규칙을 따로 쓴다.
SSH_ALLOW_CIDR=
APP_ALLOW_CIDR=                   # 비우면 0.0.0.0/0

# ── 이미지 ──
GHCR_IMAGE=ghcr.io/yoon627/coin-trading-bot
APP_VERSION=latest
GHCR_USERNAME=
GHCR_TOKEN=

# ── 앱 시크릿 ──
# APP_ENCRYPTION_SECRET 은 자동 생성하지 않는다. 저장된 Upbit 키를 복호화하는 키라 운영 중인 값을 그대로 넣는다.
DB_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_SECRET=

# Upbit 거래 키는 여기 두지 않는다. 사용자별로 앱 설정 화면에서 넣고 DB 에 암호화해 저장한다.

# ── DB 백업 (S3 호환, 선택) ──
# 서버에 키를 두므로 이 버킷에만 권한이 있는 전용 키를 쓴다. AWS S3 는 ENDPOINT 를 비운다.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=14
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_REGION=ap-northeast-2

# ── 트레이딩 ──
# 호스트를 옮기는 동안에는 false 로 둔다. 한 계정에 봇이 둘 붙으면 주문이 이중으로 나간다.
TRADING_AUTO_START=false
TRADING_TICKERS=KRW-BTC
# 배포 전 preflight_exit_params.sh 가 배포가 앱에 넘기는 키(TRADING_*·WATCHLIST_*·MARKETDATA_WATCHDOG_*·KIS_TRADING_*)와
# DISCORD_ERROR_ALERT_ENABLED 의 형식, 구간이 정해진 키의 구간(ExitParamRanges.kt·KisExitParamRanges.kt)을 본다.
# 어긋나면 배포가 멈춘다.
# 청산 5개 키는 자동매매 배포에서 필수다.
# 나머지 키는 비워 두면 TradingProperties 기본값을 쓴다. 기본값을 여기 옮겨 적지 않는다.
# 1회 매수액 = min(주문가능 KRW × INVEST_RATIO, MAX_INVEST_AMOUNT). Upbit 최소 주문은 5,000원이라 MAX_INVEST_AMOUNT 가 그보다 작으면 배포가 멈춘다.
#TRADING_INVEST_RATIO=
#TRADING_MAX_INVEST_AMOUNT=
TRADING_TAKE_PROFIT_PCT=
TRADING_MAX_LOSS_PCT=
TRADING_TRAILING_STOP_PCT=
TRADING_TRAILING_ARM_PCT=
TRADING_MAX_HOLD_DAYS=
#TRADING_ROUND_TRIP_FEE_RATE=
# 변동성 돌파 계수.
#TRADING_K_VALUE=
# 매매 루프 주기(초, ms 아님). 손절·익절·트레일링 평가가 이 주기로만 돈다.
#TRADING_INTERVAL_SECONDS=
# 미체결 매수 조회가 연속으로 이 횟수만큼 실패하면 그 종목의 신규 매수를 멈춘다(매도는 계속한다). 정수이고 구간은 README 설정 표에 있다.
#TRADING_RECONCILE_HALT_THRESHOLD=

# ── 시세 수집 ──
# WebSocket 시세 수집 대상. TRADING_TICKERS 와 따로 정하고 형식은 같다(쉼표로 구분한 대문자 Upbit 마켓 코드).
#WATCHLIST_TICKERS=
# WebSocket 무수신 감지·재연결. 저유동 마켓에서 오판해 재연결이 반복되면 false 로 끈다. 시간 키는 ms 다(AppConfig.kt).
#MARKETDATA_WATCHDOG_ENABLED=
#MARKETDATA_WATCHDOG_STALE_MS=
#MARKETDATA_WATCHDOG_INTERVAL_MS=
#MARKETDATA_WATCHDOG_INITIAL_DELAY_MS=
#MARKETDATA_WATCHDOG_RESTART_BACKOFF_MS=

# ── 그림자 청산 관측 (기본 off) ──
# 후보 청산 파라미터를 라이브와 나란히 평가해 shadow_exit_observation 에 기록만 한다. 주문은 나가지 않는다.
# 켜졌는지는 기동 로그의 [shadow-exit] 관측 on 줄로 확인한다.
#TRADING_SHADOW_EXIT_ENABLED=true
#TRADING_SHADOW_EXIT_TRAILING_STOP_PCT=1.5
#TRADING_SHADOW_EXIT_TRAILING_ARM_PCT=0

# ── KIS 주식 매매 (기본 off) ──
# 엔진에 아직 연결되지 않았다. 비워 두면 KisTradingProperties 기본값을 쓴다. 기본값을 여기 옮겨 적지 않는다.
#KIS_TRADING_ENABLED=
#KIS_TRADING_LIVE_ENABLED=
#KIS_TRADING_INVEST_RATIO=
#KIS_TRADING_MAX_INVEST_AMOUNT=
#KIS_TRADING_MAX_ORDER_AMOUNT=
#KIS_TRADING_TAKE_PROFIT_PCT=
#KIS_TRADING_MAX_LOSS_PCT=
#KIS_TRADING_TRAILING_STOP_PCT=
#KIS_TRADING_TRAILING_ARM_PCT=
#KIS_TRADING_MAX_HOLD_DAYS=
#KIS_TRADING_INTERVAL_SECONDS=
#KIS_TRADING_PAPER_MIN_REQUEST_INTERVAL_MS=
#KIS_TRADING_LIVE_MIN_REQUEST_INTERVAL_MS=
#KIS_TRADING_COMMISSION_RATE=
#KIS_TRADING_SELL_TAX_RATE=

# ── Discord 웹훅 (선택) ──
DISCORD_WEBHOOK_URL=
# 소문자 true/false 만 받는다(preflight). 오기면 새 컨테이너와 롤백이 함께 기동에 실패한다.
DISCORD_ERROR_ALERT_ENABLED=false
DISCORD_ERROR_WEBHOOK_URL=

# ── TLS / 도메인 ──
# 비우면 공인 IP 기반 sslip.io 도메인을 쓴다. IP 가 바뀌면 도메인도 바뀌므로 오래 쓸 거면 보유 도메인을 넣는다.
APP_DOMAIN=
APP_AUTH_COOKIE_FORCE_INSECURE=false
