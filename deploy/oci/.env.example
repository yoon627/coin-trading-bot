# ── OCI ──
# Always Free 컴퓨트는 테넌시 **홈 리전**에서만 만들 수 있고 홈 리전은 사후 변경이 사실상 불가하다.
# 홈 리전이 ap-chuncheon-1(춘천)이면 Ampere A1 자체를 만들 수 없다(공식 문서 명시).
# setup 이 실제 홈 리전을 조회해 여기 값과 다르면 중단한다.
OCI_REGION=ap-seoul-1
APP_NAME=coin-trading-bot
# 테넌시 OCID. 비우면 OCI_CLI_TENANCY 환경변수 → ~/.oci/config 의 tenancy 값 순으로 찾는다.
# (`oci setup config` 로 설정했다면 보통 비워둬도 자동으로 잡힌다.)
TENANCY_ID=
# 비우면 루트 compartment(=tenancy) 사용.
COMPARTMENT_ID=

# VM.Standard.A1.Flex Always Free 한도: 합계 4 OCPU / 24GB 중 이 테넌시 몫은 2 OCPU / 12GB.
# (Oracle 공식 문서: 월 1,500 OCPU 시간 + 9,000 GB 시간 = 상시 2 OCPU/12GB 상당)
SHAPE=VM.Standard.A1.Flex
OCPUS=2
MEMORY_GB=12
# Always Free 인스턴스는 최소 ~47GB 부트볼륨이 필요. boot+block 합계 무료 한도는 200GB.
BOOT_VOLUME_GB=50
# Oracle Linux 기본 SSH 사용자. Ubuntu 이미지를 쓰면 ubuntu 로 바꿀 것.
SSH_USER=opc

# ── capacity 재시도 (Always Free ARM 은 "out of host capacity" 가 상시 발생) ──
# 무한 재시도는 하지 않는다. 둘 중 먼저 걸리는 쪽에서 중단하고, 이미 만든 네트워크 리소스는 유지한다
# (같은 명령을 다시 실행하면 인스턴스 단계부터 이어서 진행).
CAPACITY_MAX_ATTEMPTS=30
CAPACITY_MAX_SECONDS=3600

# ── DB 백업 (OCI Object Storage) — backup.sh ──
# 비우면 백업 비활성. 설정하면 setup 이 버킷 + dynamic group + policy 를 함께 만든다
# (인스턴스가 instance principal 로 인증하므로 API 키를 서버에 두지 않는다).
# ⚠️ APP_ENCRYPTION_SECRET(아래) 은 이 백업 버킷과 **다른 곳**에 오프사이트 보관 — dump 에는
#    그 키로 암호화된 Upbit 키가 들어있어 같은 곳에 두면 유출 시 즉시 복호화됨.
# ⚠️ Always Free Object Storage 는 총 20GB · 월 5만 API 요청 한도. 보존 일수를 그 안에서 잡을 것.
BACKUP_BUCKET=
BACKUP_PREFIX=db-backups
BACKUP_RETENTION_DAYS=14

# 접근 제한 (보안). 비우면 setup 시 현재 공인 IP/32 로 자동 제한.
# 확인: curl -s https://checkip.amazonaws.com
SSH_ALLOW_CIDR=
APP_ALLOW_CIDR=                   # 비우면 0.0.0.0/0 (TLS 종단이라 허용, 로그인은 앱의 IP rate limit 으로 방어)

# ── 이미지 (GitHub Actions 가 GHCR 로 push) ──
GHCR_IMAGE=ghcr.io/yoon627/coin-trading-bot
APP_VERSION=latest
# GHCR 패키지가 private 이면 read:packages 권한 PAT 필요. public 으로 바꾸면 생략 가능.
GHCR_USERNAME=
GHCR_TOKEN=

# ── 앱 시크릿 ──
# ⚠️ APP_ENCRYPTION_SECRET 은 **자동 생성되지 않는다**(AWS 판과 다른 점).
#    저장된 Upbit 키를 복호화하는 AES 키라, AWS 에서 데이터를 이전해 오면서 새 키를 만들면
#    앱은 정상 기동하면서 거래소 키만 조용히 복호화 불능이 된다.
#    → AWS 쪽 deploy/aws/.env 의 값을 그대로 복사해 넣을 것.
#    (이전할 데이터가 없는 신규 구축이면 `openssl rand -base64 48` 결과를 직접 넣는다.)
# DB_PASSWORD / JWT_SECRET 은 비우면 자동 생성되어 이 파일에 저장된다.
DB_PASSWORD=
JWT_SECRET=
APP_ENCRYPTION_SECRET=

# ── Upbit API (선택: 전역/단일계정용. 멀티유저는 앱 안에서 유저별 키 등록) ──
# ⚠️ 이전 시에는 cutover 가 끝날 때까지 비워둘 것 — AWS 와 OCI 두 인스턴스가 동시에 거래를
#    활성화하면 같은 계정에 이중 주문이 나간다. README 의 cutover 절차를 따를 것.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── 트레이딩 ──
# ⚠️ 이전 직후에는 반드시 false. 검증이 끝난 뒤 수동으로 켠다(단일 실행 보장).
TRADING_AUTO_START=false
TRADING_TICKERS=KRW-BTC
TRADING_STRATEGY=combined
TRADING_TAKE_PROFIT_PCT=2.0
TRADING_MAX_LOSS_PCT=5.0
TRADING_TRAILING_STOP_PCT=2.0
# 트레일링 arm 임계(%) — 고점 수익률 도달 후에만 트레일링 평가. 0=수익 중 즉시. trail 보다 클 때만 실효
TRADING_TRAILING_ARM_PCT=0.0
# 보유 상한(거래일, KST 09:00 경계) — 1=일일리셋
TRADING_MAX_HOLD_DAYS=1
# 차트/지표 기반 청산(데드크로스 등) 토글
TRADING_CHART_EXIT_ENABLED=false
# 왕복 수수료 비율(기록용 net pnl 차감) — Upbit 0.05%x2
TRADING_ROUND_TRIP_FEE_RATE=0.001

# ── Discord 웹훅 (선택) ──
DISCORD_WEBHOOK_URL=
# 에러 알림 (opt-in): 거래 채널과 분리된 별도 webhook 권장.
DISCORD_ERROR_ALERT_ENABLED=false
DISCORD_ERROR_WEBHOOK_URL=

# ── TLS / 도메인 ──
# Caddy 가 이 도메인으로 Let's Encrypt 인증서를 자동 발급/갱신한다(HTTPS 종단).
# 비우면 deploy.sh 가 공인 IP 기반 sslip.io 도메인(예: 140-238-1-2.sslip.io)으로 자동 생성.
# ⚠️ sslip.io 자동 도메인은 IP 가 바뀌면 도메인도 바뀐다(인증서·CORS·북마크 모두 영향).
#    운영을 오래 할 거면 보유 도메인의 A 레코드를 인스턴스 IP 로 연결하고 여기에 적는 편이 낫다.
APP_DOMAIN=

# TLS 가 Caddy 로 종단되므로 평소 false 유지. true 는 TLS 없이 HTTP 로만 임시 운영할 때만.
APP_AUTH_COOKIE_FORCE_INSECURE=false
